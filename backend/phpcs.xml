<?xml version="1.0"?>
<ruleset name="ONESALEZ Service CRM">
    <description>PSR-12 coding standard.</description>
    <file>src</file>
    <file>public</file>
    <file>bin</file>
    <file>tests</file>
    <file>bootstrap.php</file>
    <exclude-pattern>vendor/*</exclude-pattern>
    <arg name="colors"/>
    <arg value="sp"/>
    <rule ref="PSR12">
        <exclude name="Generic.Files.LineLength"/>
    </rule>
</ruleset>
