{
  "name": "onesalez/service-crm",
  "description": "ONESALEZ Service Tracker REST API",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": "^8.3",
    "ext-json": "*",
    "ext-pdo": "*",
    "ext-pdo_mysql": "*",
    "firebase/php-jwt": "^6.11",
    "monolog/monolog": "^3.9",
    "vlucas/phpdotenv": "^5.6"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5",
    "phpstan/phpstan": "^2.1",
    "squizlabs/php_codesniffer": "^3.13"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "analyse": "phpstan analyse",
    "cs": "phpcs",
    "check": ["@cs", "@analyse", "@test"]
  },
  "config": {
    "sort-packages": true,
    "optimize-autoloader": true,
    "platform-check": false,
    "platform": {"php": "8.3.0"}
  }
}
