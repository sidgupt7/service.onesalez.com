Options -Indexes
RewriteEngine On

# HTML and worker updates must revalidate, including SPA routes rewritten to index.html.
<IfModule mod_headers.c>
    <FilesMatch "^(index\.html|sw\.js|registerSW\.js|manifest\.webmanifest|deploy-version\.txt)$">
        Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
        Header always set Pragma "no-cache"
        Header always set Expires "0"
    </FilesMatch>
</IfModule>

RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Keep the application source and environment inaccessible from the web.
RewriteRule ^app(?:/|$) - [F,L]

# Send API requests to the PHP front controller.
RewriteRule ^api/v1(?:/.*)?$ api/index.php [QSA,L]

# Serve real static files, otherwise return the React application shell.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]
RewriteRule ^ index.html [L]

<FilesMatch "^\.">
    Require all denied
</FilesMatch>
